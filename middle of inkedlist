lass Solution {
    public ListNode middleNode(ListNode head) {
        ListNode dummy=head;
        int a=0;
        while(dummy!=null){
            a++;
            dummy=dummy.next;
        }
        if(a%2!=0) a=(a+1)/2;
        else a=(a/2)+1;
        ListNode slow=head;
        for(int i=1;i<a;i++){
            slow=slow.next;
        }
        return slow;
    }
}
